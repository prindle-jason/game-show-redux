{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "gameshow-party",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-01",
  "durable_objects": {
    "bindings": [
      {
        "name": "GAME_ROOM",
        "class_name": "GameRoom"
      }
    ]
  },
  "r2_buckets": [
    {
      "binding": "MEDIA",
      "bucket_name": "gameshow-media"
    }
  ],
  // MEDIA_BASE_URL / MEDIA_UPLOAD_SECRET are deliberately NOT declared as
  // `vars` here — a plaintext `vars` entry is redeployed verbatim every time
  // and silently overwrites any same-named `wrangler secret put` value in
  // production. Local dev supplies both via `.dev.vars` (gitignored, read
  // automatically by `wrangler dev` and vitest-pool-workers); production
  // supplies both via `wrangler secret put`.
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["GameRoom"]
    }
  ]
}
